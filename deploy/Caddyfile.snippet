# Add to the devserver's Caddyfile, then: caddy validate && systemctl reload caddy
# The bind line keeps Caddy off the Tailscale address, where tailscale serve owns 443
# (same as the other site blocks on the devserver).
#
# Addresses (Jonas, 2026-11-18: the game is called Skargardsbyn everywhere):
#   https://dev.skargardsbyn.84.247.143.6.sslip.io/  the dev build (dev menu)
#   https://skargardsbyn.84.247.143.6.sslip.io/      the playtest build
# The old wormwood. and spela. addresses redirect there, so old links keep working.
http://dev.skargardsbyn.84.247.143.6.sslip.io, http://skargardsbyn.84.247.143.6.sslip.io {
	bind 84.247.143.6
	redir https://{host}{uri} permanent
}

dev.skargardsbyn.84.247.143.6.sslip.io, skargardsbyn.84.247.143.6.sslip.io {
	bind 84.247.143.6
	encode gzip zstd
	reverse_proxy 127.0.0.1:8787
}

http://wormwood.84.247.143.6.sslip.io, wormwood.84.247.143.6.sslip.io {
	bind 84.247.143.6
	redir https://dev.skargardsbyn.84.247.143.6.sslip.io{uri} permanent
}

http://spela.84.247.143.6.sslip.io, spela.84.247.143.6.sslip.io {
	bind 84.247.143.6
	redir https://skargardsbyn.84.247.143.6.sslip.io{uri} permanent
}
